#===============================================================================
# Configuration
#===============================================================================

[Function F_Level_Config()]

#	<<Text>>
#	<Rewards>
mapSet{map: "_lvlsyscfg_rewards_offsetx"; value: 3}			# X offset
mapSet{map: "_lvlsyscfg_rewards_offsety"; value: 64}		# Y offset
mapSet{map: "_lvlsyscfg_rewards_scale"; value: 0.5}			# Scale
mapSet{map: "_lvlsyscfg_rewards_font"; value: 1}			# Font
mapSet{map: "_lvlsyscfg_rewards_aidisplay"; value: 1}		# AI characters display this text

#	<Stats>
mapSet{map: "_lvlsyscfg_stats_offsetx"; value: 90}			# X offset
mapSet{map: "_lvlsyscfg_stats_offsety"; value: 33}			# Y offset
mapSet{map: "_lvlsyscfg_stats_scale"; value: 0.5}			# Scale
mapSet{map: "_lvlsyscfg_stats_font"; value: 1}				# Font
mapSet{map: "_lvlsyscfg_stats_aidisplay"; value: 1}			# AI characters display this text


#	<<Settings>>
mapSet{map: "_lvlsyscfg_ailevelup"; value: 1}				# Allow AI to level up (Only P1 will level up with this enabled)
mapSet{map: "_lvlsyscfg_cashinperround"; value: 1}			# Players will convert EXP into Level every round. If 0, it'll only convert at the end of the match
mapSet{map: "_lvlsyscfg_maxlevel"; value: 20}				# Max level per character
mapSet{map: "_lvlsyscfg_resetlvl"; value: 0}				# Define if and when a character should lose all their levels on defeat
															# 0 = Never
															# 1 = After losing a match
															# 2 = After losing a round


#===============================================================================
# Global states (not halted by Pause/SuperPause, no helper limitations)
#===============================================================================
[StateDef -4]
ignoreHitPause if map(_lvlsysflag_fileloaded) = 0 {
	loadFile {
		savedata: map;
		path: "level.gob";
		maps: "_lvlsys_level"
	}
	map(_lvlsysflag_fileloaded) := 1;
}

call F_Level_Config();
ignoreHitPause if !isHelper {
	# Reset maps
	if roundState < 2 {
		map(_lvlsysflag_expfinished) := 0;
		map(_lvlsysflag_filesaved) := 0;
	}
	if map(_lvlsys_level) > map(_lvlsyscfg_maxlevel) && map(_lvlsys_exp) > 0 {
		mapSet{map: "_lvlsys_level"; value: map(_lvlsyscfg_maxlevel);}
		mapSet{map: "_lvlsys_exp"; value: 0;}
	}
}

if outroState >= 4 && time%2 = 0 && ifElse(map(_lvlsyscfg_cashinperround), 1, matchOver) {
	while map(_lvlsysflag_expfinished) = 0 {
		assertSpecial{flag: RoundNotSkip;}
	}
	if !alive && map(_lvlsyscfg_resetlvl) > 0 && ifElse(map(_lvlsyscfg_resetlvl) = 1, matchOver, 1) {
		map(_lvlsys_level) := 0;
		map(_lvlsys_exp) := 0;
		map(_lvlsysflag_expfinished) := 1;
	}
	if map(_lvlsys_exp) >= 100 {
		mapAdd{map: "_lvlsys_level"; value: 0.1;}
		mapAdd{map: "_lvlsys_exp"; value: -100;}
	} else if map(_lvlsys_exp) >= 10 {
		mapAdd{map: "_lvlsys_level"; value: 0.01;}
		mapAdd{map: "_lvlsys_exp"; value: -10;}
	} else if map(_lvlsys_exp) >= 1 {
		mapAdd{map: "_lvlsys_level"; value: 0.001;}
		mapAdd{map: "_lvlsys_exp"; value: -1;}
	} else if map(_lvlsys_exp) = 0 {
		map(_lvlsysflag_expfinished) := 1;
	}
}

if map(_lvlsysflag_expfinished) = 1 && map(_lvlsysflag_filesaved) = 0  && map(_lvlsysflag_fileloaded) = 1 {
	if !aiLevel
	|| aiLevel && map(_lvlsyscfg_ailevelup) && teamside = 1 {
		saveFile {
			savedata: map;
			path: "level.gob";
			maps: "_lvlsys_level"
		}
		map(_lvlsysflag_filesaved) := 1;
	}
}


#===============================================================================
# Global states (not halted by Pause/SuperPause, no helper limitations)
#===============================================================================
[StateDef +1]
ignoreHitPause if !isHelper && teamSide = 1 && playerNo = teamLeader {
	call F_Level_Config();
	if roundState != 0 && ifElse(map(_lvlsyscfg_stats_aidisplay), 1,!ailevel) {
		# Stats
		text {
			localcoord: 320, 240;
			pos: ifElse(const(LevelSys.StatsOffsetX), const(LevelSys.StatsOffsetX), map(_lvlsyscfg_stats_offsetx)), ifElse(const(LevelSys.StatsOffsetY), const(LevelSys.StatsOffsetY), map(_lvlsyscfg_stats_offsety));
			font: F map(_lvlsyscfg_stats_font);
			bank: 0;
			layerno: 1;
			scale: map(_lvlsyscfg_stats_scale), map(_lvlsyscfg_stats_scale);
			text:"Level: %.1f";
			params: map(_lvlsys_level);
			color: 255, cond(ifElse(!map(_lvlsyscfg_resetlvl), alive, 1), 255, 0), cond(ifElse(!map(_lvlsyscfg_resetlvl), alive, 1), 255, 0), 255;
			hidewithbars: 1;
		}
	}
	if outroState >= 3 && roundState > 2 && ifElse(map(_lvlsyscfg_rewards_aidisplay), 1,!ailevel) {
		text {
			localcoord: 320, 240;
			pos: map(_lvlsyscfg_rewards_offsetx), map(_lvlsyscfg_rewards_offsety);
			font: F map(_lvlsyscfg_rewards_font);
			bank: 0;
			layerno: 1;
			scale: map(_lvlsyscfg_rewards_scale), map(_lvlsyscfg_rewards_scale);
			text:"EXP Earned: %.0f\nLevel: %.2f";
			params: map(_lvlsys_exp), map(_lvlsys_level);
			hidewithbars: 1;
		}
	}
}

ignoreHitPause if !isHelper && teamSide = 2 && playerNo = teamLeader {
	call F_Level_Config();
	if roundState != 0 && ifElse(map(_lvlsyscfg_stats_aidisplay), 1,!ailevel) {
		# Stats
		text {
			localcoord: 320, 240;
			pos: 319 - ifElse(const(LevelSys.StatsOffsetX), const(LevelSys.StatsOffsetX), map(_lvlsyscfg_stats_offsetx)), ifElse(const(LevelSys.StatsOffsetY), const(LevelSys.StatsOffsetY), map(_lvlsyscfg_stats_offsety));
			font: F map(_lvlsyscfg_stats_font);
			bank: 0;
			align: -1;
			layerno: 1;
			scale: map(_lvlsyscfg_stats_scale), map(_lvlsyscfg_stats_scale);
			text:"Level: %.1f";
			params: map(_lvlsys_level);
			color: 255, cond(ifElse(!map(_lvlsyscfg_resetlvl), alive, 1), 255, 0), cond(ifElse(!map(_lvlsyscfg_resetlvl), alive, 1), 255, 0), 255;
			hidewithbars: 1;
		}
	}
	if outroState >= 3 && roundState > 2 && ifElse(map(_lvlsyscfg_rewards_aidisplay), 1,!ailevel) {
		text {
			localcoord: 320, 240;
			pos: 319 - map(_lvlsyscfg_rewards_offsetx), map(_lvlsyscfg_rewards_offsety);
			font: F map(_lvlsyscfg_rewards_font);
			bank: 0;
			align: -1;
			layerno: 1;
			scale: map(_lvlsyscfg_rewards_scale), map(_lvlsyscfg_rewards_scale);
			text:"Total EXP: %.0f\nLevel: %.2f";
			params: map(_lvlsys_exp), map(_lvlsys_level);
			hidewithbars: 1;
		}
	}
}